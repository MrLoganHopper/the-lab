# Copy this file to .env. The app works in demo mode without Google credentials.
PORT=3001
TIME_ZONE=America/Los_Angeles
CAPACITY=10
SLOT_MINUTES=30
DEMO_MODE=true
# Choose a private password to view the admin page.
ADMIN_KEY=replace-this-with-a-long-random-secret
# For LIVE Google Calendar integration, set all three values:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
